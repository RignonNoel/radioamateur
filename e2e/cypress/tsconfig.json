{
    "compilerOptions": {
      "target": "ES2020",
      "lib": ["ES2020", "DOM"],
      "types": ["cypress"],
      "module": "CommonJS",
      "moduleResolution": "node",
      "resolveJsonModule": true,
      "isolatedModules": false,
      "esModuleInterop": true,
      "strict": false,
      "noEmit": true
    },
    "include": [
      "**/*.ts"
    ]
  }